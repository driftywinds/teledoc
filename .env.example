# Telegram bot token - create a bot with @BotFather, then:
#   1. Add the bot to your channel as an ADMIN (with "Post Messages" permission)
#   2. Upload documents to the channel; the bot archives every upload made
#      AFTER it was added (bots cannot read channel history).
BOT_TOKEN=

# Optional: require this password on the web UI (recommended if not on trusted LAN).
# Leave empty to disable authentication.
ADMIN_PASSWORD=

# Where the SQLite database lives (Windows: e.g. C:\data\teledoc.db)
DB_PATH=/data/teledoc.db

# Address the web UI listens on
LISTEN_ADDR=:9879

# Temp downloads: when a download button is clicked on the documents page,
# files up to the Bot API's 20 MB cap are fetched from Telegram into TEMP_DIR
# and served from /temp/... for TEMP_FILE_TTL_MINUTES minutes (a repeat
# click inside that window re-serves the same file without re-downloading;
# larger files always open in Telegram). Only teledoc- prefixed files inside
# TEMP_DIR are ever created or deleted — the directory may safely be a mapped
# volume holding other data.
TEMP_DIR=/data/temp
TEMP_FILE_TTL_MINUTES=10
